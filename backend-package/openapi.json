{
  "openapi": "3.1.0",
  "info": {
    "title": "LogicKernel Content and Submissions API",
    "version": "1.0",
    "description": "Контракт текущего фронтенда. Полное руководство: BACKEND.md. Авторизация и синхронизация профиля/прогресса требуют отдельной интеграции."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin API"
    },
    {
      "url": "http://127.0.0.1:4180/api/v1",
      "description": "Локальный пример API материалов"
    }
  ],
  "paths": {
    "/courses": {
      "get": {
        "operationId": "listCourses",
        "summary": "Весь каталог без пагинации",
        "responses": {
          "200": {
            "description": "Все карточки курсов",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/content.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "./schemas/content.schema.json#/$defs/courseSummary"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/courses/{courseId}": {
      "get": {
        "operationId": "getCourse",
        "summary": "Программа курса с модулями",
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Курс",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/content.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "./schemas/content.schema.json#/$defs/course"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/lessons/{lessonId}": {
      "get": {
        "operationId": "getLesson",
        "summary": "Полный урок с упражнением",
        "parameters": [
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Урок",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/content.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "./schemas/content.schema.json#/$defs/lesson"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/submissions": {
      "get": {
        "operationId": "listSubmissions",
        "summary": "Последние 20 попыток пользователя по уроку, новые первыми",
        "parameters": [
          {
            "name": "lessonId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Попытки с исходными снимками кода; пустой массив допустим",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "./schemas/submission-response.schema.json#/properties/data"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "schemaVersion"
                      ],
                      "properties": {
                        "schemaVersion": {
                          "const": "1.0"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submit",
        "summary": "Сохранить снимок решения и поставить проверку в очередь",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/submission-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Попытка создана или возвращена по ключу идемпотентности",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/submission-response.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/submissions/{submissionId}": {
      "get": {
        "operationId": "getSubmission",
        "summary": "Статус, результат и исходный снимок решения",
        "parameters": [
          {
            "name": "submissionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Попытка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/submission-response.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/task-submissions": {
      "post": {
        "operationId": "submitTask",
        "summary": "Отправить решение отдельной задачи",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./schemas/task-submission-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Попытка проверки задачи",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/task-submission-response.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/task-submissions/{submissionId}": {
      "get": {
        "operationId": "getTaskSubmission",
        "summary": "Результат отдельной задачи",
        "parameters": [
          {
            "name": "submissionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Попытка проверки задачи",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/task-submission-response.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
