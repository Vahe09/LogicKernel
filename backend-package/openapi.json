{
  "openapi": "3.1.0",
  "info": {
    "title": "LogicKernel API",
    "version": "1.0",
    "description": "Контракт фронтенда: материалы, регистрация, cookie-сессии, профиль и попытки. Учебные примеры Python и порядок реализации — в BACKEND.md."
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lk_session",
        "description": "Серверная сессия, HttpOnly cookie. GET /auth/session создаёт также гостевую сессию."
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin API"
    },
    {
      "url": "http://127.0.0.1:4180/api/v1",
      "description": "Локальный пример API материалов"
    }
  ],
  "paths": {
    "/auth/session": {
      "get": {
        "operationId": "getSession",
        "summary": "Восстановить пользователя и получить CSRF-токен; для гостя user null",
        "responses": {
          "200": {
            "description": "Сессия; при необходимости сервер устанавливает cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/session-response.schema.json"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка API; см. error.code и error.message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code",
                        "message"
                      ],
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {},
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
