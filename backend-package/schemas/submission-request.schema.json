{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"POST /api/v1/submissions",
  "type":"object","additionalProperties":false,
  "required":["lessonId","lessonVersion","exerciseId","exerciseVersion","language","runtimeProfileId","files","stdin"],
  "properties":{
    "lessonId":{"type":"string","minLength":1},"lessonVersion":{"type":"integer","minimum":1},
    "exerciseId":{"type":"string","minLength":1},"exerciseVersion":{"type":"integer","minimum":1},
    "language":{"enum":["python","javascript","typescript","html","sql","csharp","c","cpp","go","rust"]},
    "runtimeProfileId":{"type":"string","minLength":1},
    "files":{"type":"array","minItems":1,"maxItems":10,"items":{"type":"object","additionalProperties":false,"required":["path","code"],"properties":{"path":{"type":"string","minLength":1},"code":{"type":"string","maxLength":65536}}}},
    "stdin":{"type":"string","maxLength":8192}
  },
  "$comment":"Enforce UTF-8 byte limits, allowed paths, runtime/lesson ownership and versions on the server in addition to this schema. User identity comes from the session, never the body."
}
