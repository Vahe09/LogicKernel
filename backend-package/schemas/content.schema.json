{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logickernel.example/schemas/content-v1.json",
  "title": "LogicKernel curriculum API response v1",
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contentVersion"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "data": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/courseSummary"
          }
        },
        {
          "$ref": "#/$defs/course"
        },
        {
          "$ref": "#/$defs/lesson"
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 100
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "courseSummary": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "title",
        "subtitle",
        "description",
        "level",
        "category",
        "language",
        "base",
        "hours",
        "lessons",
        "teacher",
        "version",
        "prerequisites",
        "outcomes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "subtitle": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "level": {
          "type": "string"
        },
        "category": {
          "enum": [
            "frontend",
            "backend",
            "systems",
            "fundamentals"
          ]
        },
        "language": {
          "enum": [
            "python",
            "javascript",
            "typescript",
            "html",
            "sql",
            "csharp",
            "c",
            "cpp",
            "go",
            "rust"
          ]
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "hours": {
          "type": "number",
          "minimum": 0
        },
        "lessons": {
          "type": "integer",
          "minimum": 1
        },
        "teacher": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "prerequisites": {
          "type": "string"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "not": {
        "required": [
          "modules"
        ]
      }
    },
    "course": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "title",
        "subtitle",
        "description",
        "level",
        "category",
        "language",
        "base",
        "hours",
        "lessons",
        "teacher",
        "version",
        "prerequisites",
        "outcomes",
        "modules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "subtitle": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "category": {
          "enum": [
            "frontend",
            "backend",
            "systems",
            "fundamentals"
          ]
        },
        "language": {
          "enum": [
            "python",
            "javascript",
            "typescript",
            "html",
            "sql",
            "csharp",
            "c",
            "cpp",
            "go",
            "rust"
          ]
        },
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "hours": {
          "type": "number",
          "minimum": 0
        },
        "lessons": {
          "type": "integer",
          "minimum": 1
        },
        "teacher": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "prerequisites": {
          "type": "string"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "title",
        "position",
        "lessons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "position",
              "estimatedMinutes",
              "hasPractice"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "$ref": "#/$defs/text"
              },
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "estimatedMinutes": {
                "type": "integer",
                "minimum": 1
              },
              "hasPractice": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "courseId",
        "moduleId",
        "position",
        "slug",
        "title",
        "version",
        "estimatedMinutes",
        "level",
        "objectives",
        "blocks",
        "exercise",
        "references",
        "navigation",
        "completionPolicy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "courseId": {
          "$ref": "#/$defs/id"
        },
        "moduleId": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "slug": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "level": {
          "type": "string"
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "exercise": {
          "$ref": "#/$defs/exercise"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        },
        "navigation": {
          "type": "object",
          "required": [
            "previousId",
            "nextId"
          ],
          "properties": {
            "previousId": {
              "type": [
                "string",
                "null"
              ]
            },
            "nextId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "completionPolicy": {
          "enum": [
            "server_accepted_submission",
            "reading_acknowledgement_and_server_accepted_submission"
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "reference",
            "code",
            "callout",
            "steps",
            "glossary",
            "checklist"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "heading",
                "paragraph",
                "reference"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "code"
            },
            "language": {
              "type": "string"
            },
            "filename": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          },
          "required": [
            "language",
            "filename",
            "code"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "callout"
            },
            "tone": {
              "enum": [
                "info",
                "warning"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "tone",
            "title",
            "text"
          ]
        },
        {
          "properties": {
            "type": {
              "enum": [
                "steps",
                "checklist"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "title",
            "items"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "glossary"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "term",
                  "definition"
                ],
                "properties": {
                  "term": {
                    "type": "string"
                  },
                  "definition": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "title",
            "items"
          ]
        }
      ]
    },
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "prompt",
        "language",
        "runtimeProfileId",
        "files",
        "entryFile",
        "stdin",
        "publicExamples",
        "hints",
        "constraints",
        "grading"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "language": {
          "type": "string"
        },
        "runtimeProfileId": {
          "$ref": "#/$defs/id"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "language",
              "editable",
              "starterCode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_./-]+$"
              },
              "language": {
                "type": "string"
              },
              "editable": {
                "type": "boolean"
              },
              "starterCode": {
                "type": "string"
              }
            }
          }
        },
        "entryFile": {
          "type": "string"
        },
        "stdin": {
          "type": "object",
          "required": [
            "enabled",
            "defaultValue",
            "label",
            "help"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "defaultValue": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "help": {
              "type": "string"
            }
          }
        },
        "publicExamples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "input",
              "expectedOutput",
              "description"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "input": {
                "type": "string"
              },
              "expectedOutput": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "required": [
            "maxCodeBytes",
            "maxStdinBytes",
            "timeLimitMs",
            "memoryLimitMb"
          ],
          "properties": {
            "maxCodeBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxStdinBytes": {
              "type": "integer",
              "minimum": 0
            },
            "timeLimitMs": {
              "type": "integer",
              "minimum": 1
            },
            "memoryLimitMb": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "grading": {
          "type": "object",
          "required": [
            "strategy",
            "serverOnly",
            "hiddenTestsIncluded"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "program",
                "query",
                "document",
                "review"
              ]
            },
            "serverOnly": {
              "const": true
            },
            "hiddenTestsIncluded": {
              "const": false
            }
          }
        },
        "fixture": {
          "type": "object",
          "required": [
            "id",
            "label",
            "tables"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "tables": {
              "type": "array"
            }
          }
        },
        "review": {
          "type": "object",
          "required": [
            "kind",
            "criteria",
            "projectScope",
            "tradeoff"
          ],
          "properties": {
            "kind": {
              "enum": [
                "implementation",
                "verification",
                "project"
              ]
            },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "projectScope": {
              "type": "string",
              "minLength": 1
            },
            "tradeoff": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
