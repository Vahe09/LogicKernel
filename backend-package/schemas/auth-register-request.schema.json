{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/v1/auth/register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "surname",
    "email",
    "password"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "surname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    }
  }
}
